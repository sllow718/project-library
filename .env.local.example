# Admin password — pick anything you want, used to log into /admin
ADMIN_PASSWORD=

# Firebase Admin SDK (server-side, used for SSG/ISR on Vercel)
# Get these from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK (client-side, used by the admin panel in the browser)
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app → Config
# Copy the entire firebaseConfig object as a single-line JSON string
NEXT_PUBLIC_FIREBASE_CONFIG=
